
gcp_project_id           = "replace-me-prod-project"
region                   = "us-central1"
environment              = "prod"
artifact_registry_location = "us-central1"

backend_image            = "us-central1-docker.pkg.dev/replace-me-prod-project/panol-apps-prod/backend:latest"
bot_image                = "us-central1-docker.pkg.dev/replace-me-prod-project/panol-apps-prod/bot:latest"
frontend_image           = "us-central1-docker.pkg.dev/replace-me-prod-project/panol-apps-prod/frontend:latest"

supabase_db_host         = "aws-1-us-east-1.pooler.supabase.com"
supabase_db_port         = 5432
supabase_db_name         = "postgres"
supabase_db_user         = "postgres.replace_me"

app_security_enabled              = true
app_auth_max_failed_attempts      = 5
app_auth_lock_minutes             = 15
app_auth_jwt_issuer               = "panol-backend-prod"
app_auth_jwt_expiration_seconds   = 3600
app_auth_refresh_expiration_seconds = 604800
app_auth_cookie_secure            = true
app_auth_cookie_same_site         = "Lax"
app_auth_token_revocation_cleanup_enabled          = true
app_auth_token_revocation_cleanup_initial_delay_ms = 300000
app_auth_token_revocation_cleanup_delay_ms         = 1800000
app_auth_token_revocation_cleanup_batch_size       = 500
jwt_issuer_uri                    = "https://replace-me.supabase.co/auth/v1"
vite_supabase_publishable_key     = "sb_publishable_replace_me"

backend_domain           = ""
bot_domain               = "bot.panol.cl"
frontend_domain          = ""

backend_min_instances    = 1
backend_max_instances    = 5
backend_timeout_seconds  = 300
backend_concurrency      = 80
bot_min_instances        = 0
bot_max_instances        = 2
bot_timeout_seconds      = 120
bot_concurrency          = 10
gemini_model             = "gemini-2.5-flash-lite"
bot_llm_timeout_seconds  = 20
bot_backend_timeout_seconds = 10
bot_backend_retry_count  = 0
frontend_min_instances   = 1
frontend_max_instances   = 5
frontend_timeout_seconds = 120
frontend_concurrency     = 80

# Sensitive values should be provided via TF_VAR_* in CI/CD or local shell.
# Keep them empty in tfvars when not needed.
db_supabase_password_secret_value  = ""
app_auth_jwt_secret_value          = ""
app_security_ai_agent_secret_value = ""
google_api_key_secret_value        = ""

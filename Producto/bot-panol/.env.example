GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=75
BACKEND_BASE_URL=http://backend:8080
BACKEND_CLIENT_SECRET=your_backend_ai_agent_secret_here
BACKEND_TIMEOUT_SECONDS=10
BACKEND_RETRY_COUNT=0
BOT_SECRET_KEY=your_bot_fallback_secret_here
JWT_SECRET_KEY=your_backend_jwt_secret_here
JWT_ISSUER=panol-backend
JWT_AUDIENCE=bot-panol
JWT_LEEWAY_SECONDS=30
MAX_ITERATIONS=10
MAX_HISTORY_MESSAGES=20
METRICS_ENABLED=true
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:18081,http://127.0.0.1:18081,http://localhost:5173,http://127.0.0.1:5173

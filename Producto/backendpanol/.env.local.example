# Copy this file to .env.local and adjust values per environment.
APP_PORT=8080
APP_DB_ENV=supabase
APP_SECURITY_ENABLED=true
APP_AUTH_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCK_MINUTES=15
APP_AUTH_JWT_ISSUER=panol-backend-dev

# Auth tokens and cookies
APP_AUTH_JWT_EXPIRATION_SECONDS=3600
APP_AUTH_REFRESH_EXPIRATION_SECONDS=604800
APP_AUTH_REFRESH_TEMPORARY_EXPIRATION_SECONDS=86400
APP_AUTH_BOT_TOKEN_EXPIRATION_SECONDS=300
APP_AUTH_BOT_TOKEN_AUDIENCE=bot-panol
# En localhost HTTP debe quedar false. En entornos HTTPS desplegados debe ser true.
APP_AUTH_COOKIE_SECURE=false
# Lax funciona para frontend/backend same-site como localhost o subdominios del mismo sitio.
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_TOKEN_REVOCATION_CLEANUP_ENABLED=true
APP_AUTH_TOKEN_REVOCATION_CLEANUP_INITIAL_DELAY_MS=300000
# 86400000 ms = 1 dia
APP_AUTH_TOKEN_REVOCATION_CLEANUP_DELAY_MS=86400000
APP_AUTH_TOKEN_REVOCATION_CLEANUP_BATCH_SIZE=500
# APP_AUTH_JWT_SECRET=replace_me

# Transactional email delivery
APP_EMAIL_ENABLED=true
APP_EMAIL_PROVIDER=resend
# APP_EMAIL_RESEND_API_KEY=replace_me
APP_EMAIL_FROM_NAME=Panol
APP_EMAIL_FROM_ADDRESS=notificaciones@panol.cl
APP_FRONTEND_BASE_URL=http://localhost:18081
APP_EMAIL_WORKER_DELAY_MS=5000
APP_EMAIL_BATCH_SIZE=20
APP_EMAIL_MAX_RETRIES=5
APP_EMAIL_CONNECT_TIMEOUT_MS=5000
APP_EMAIL_READ_TIMEOUT_MS=10000

# Docker local DB
# - Si el backend corre desde tu host/IDE, deja `localhost`.
# - Si el backend corre en Docker Compose, los compose inyectan `panol-postgres`.
DB_DOCKER_HOST=localhost
DB_DOCKER_PORT=5432
DB_DOCKER_NAME=panol
DB_DOCKER_USER=panol_user
DB_DOCKER_SSL_MODE=disable
# DB_DOCKER_PASSWORD=replace_me

# Supabase DB
DB_SUPABASE_HOST=aws-1-us-east-1.pooler.supabase.com
DB_SUPABASE_PORT=5432
DB_SUPABASE_NAME=postgres
DB_SUPABASE_USER=postgres.ekqbucfoygimzgxupdhm
DB_SUPABASE_SSL_MODE=require
# DB_SUPABASE_PASSWORD=replace_me

JWT_ISSUER_URI=https://ekqbucfoygimzgxupdhm.supabase.co/auth/v1
VITE_SUPABASE_URL=https://ekqbucfoygimzgxupdhm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zz8M0TK5BSRjk00UMl9h6g_qgWycc02

# jOOQ code generation (Postgres introspection)
JOOQ_DB_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
JOOQ_DB_USER=postgres.ekqbucfoygimzgxupdhm
# JOOQ_DB_PASSWORD=replace_me
